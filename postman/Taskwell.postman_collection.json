{
  "info": {
    "name": "Taskwell \u2014 Student Task Monitoring API",
    "_postman_id": "stms-2026-api-contract",
    "description": "Run in folder order. Creates a unique test account and removes the generated task/subject. Some account changes persist by design. Requires a migrated SQLite database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": []
      }
    }
  ],
  "variable": [
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "TestPass123!"
    },
    {
      "key": "newTestPassword",
      "value": "AnotherPass123!"
    },
    {
      "key": "subjectId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "submissionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Register a test student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "const payload = pm.response.json();",
                  "pm.test(\"Success envelope\", () => pm.expect(payload.success).to.eql(true));",
                  "pm.test(\"User and token returned\", () => { pm.expect(payload.data.user.email).to.eql(pm.collectionVariables.get(\"testEmail\")); pm.expect(payload.data.token).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"authToken\",payload.data.token);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testEmail', 'stms+' + Date.now() + Math.floor(Math.random()*9999) + '@example.com');"
                ]
              }
            }
          ]
        },
        {
          "name": "View own profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => pm.response.to.be.json);",
                  "const payload = pm.response.json();",
                  "pm.test(\"Success envelope\", () => pm.expect(payload.success).to.eql(true));",
                  "pm.test(\"User profile present\", () => pm.expect(payload.data.user).to.have.property(\"id\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid password rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"wrong-password\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Error envelope\", () => { const d = pm.response.json(); pm.expect(d.success).to.eql(false); pm.expect(d.error.message).to.be.a(\"string\"); });"
                ]
